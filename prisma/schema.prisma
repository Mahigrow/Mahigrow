generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ── RETAILER ──────────────────────────────────────────────────
model Retailer {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String   @unique
  passwordHash String
  shopName     String
  ownerName    String
  gstin        String?  @unique
  gstVerified  Boolean  @default(false)
  district     String
  state        String   @default("Andhra Pradesh")
  pincode      String
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions RetailerSession[]
  orders   Order[]
  otps     OTP[]
}

// ── SESSION ───────────────────────────────────────────────────
model RetailerSession {
  id         String   @id @default(cuid())
  token      String   @unique @default(cuid())
  retailer   Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  retailerId String
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([token])
}

// ── OTP ───────────────────────────────────────────────────────
model OTP {
  id         String     @id @default(cuid())
  retailer   Retailer   @relation(fields: [retailerId], references: [id], onDelete: Cascade)
  retailerId String
  code       String
  purpose    OTPPurpose
  expiresAt  DateTime
  used       Boolean    @default(false)
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([retailerId, purpose])
}

enum OTPPurpose {
  RESET_PASSWORD
}

// ── PRODUCT ───────────────────────────────────────────────────
model Product {
  id          String   @id @default(cuid())
  name        String
  brand       String
  category    String
  description String?
  size        String
  mrp         Int      // in paise
  cert        String
  unit        String
  moq         Int
  step        Int
  inStock     Boolean  @default(true)
  stockQty    Int      @default(0)
  imageUrl    String?
  isActive    Boolean  @default(true)
  tiers       Json     // [[minQty, maxQty, priceInPaise], ...]
  variants    Json?    // [{size:"100ml", mrp:18000, tiers:[[20,59,16000],[60,null,15000]]}, ...]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems OrderItem[]

  @@index([category, isActive])
}

// ── ORDER ─────────────────────────────────────────────────────
model Order {
  id            String      @id @default(cuid())
  retailer      Retailer    @relation(fields: [retailerId], references: [id])
  retailerId    String
  status        OrderStatus @default(PLACED)
  paymentMethod String      @default("COD")
  subtotal      Int         // paise ex-GST
  gstAmount     Int         @default(0)
  grandTotal    Int         // paise inc-GST
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items OrderItem[]

  @@index([retailerId, status])
  @@index([status])
}

// ── ORDER ITEM ────────────────────────────────────────────────
model OrderItem {
  id        String  @id @default(cuid())
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product @relation(fields: [productId], references: [id])
  productId String
  qty         Int
  variantSize String? // e.g. "100ml", "1L" — null if product has no variants
  rate        Int     // paise per unit at time of order
  total       Int     // paise total for this item

  @@index([orderId])
}

// ── ORDER STATUS ──────────────────────────────────────────────
enum OrderStatus {
  PLACED           // retailer placed the order
  PACKING          // admin is packing
  OUT_FOR_DELIVERY // dispatched to retailer
  DELIVERED        // delivered successfully
  CANCELLED        // cancelled by admin or retailer
}
