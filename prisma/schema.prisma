generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

model Retailer {
  id           String   @id @default(cuid())
  phone        String   @unique
  passwordHash String
  shopName     String
  ownerName    String
  gstin        String   @unique
  district     String   @default("")
  pincode      String   @default("")
  state        String   @default("")
  email        String?
  gstVerified  Boolean  @default(false)
  isActive     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders Order[]
  otps   OTP[]
}

model OTP {
  id         String   @id @default(cuid())
  retailerId String
  code       String   // ← field name is 'code' (not 'otp')
  purpose    String   // VERIFY_PHONE | RESET_PASSWORD
  expiresAt  DateTime
  attempts   Int      @default(0)
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())

  retailer Retailer @relation(fields: [retailerId], references: [id], onDelete: Cascade)
}

model Product {
  id         String   @id @default(cuid())
  name       String
  category   String   // seeds | pesticides | insecticides | fertilisers | fungicides | herbicides
  brand      String   @default("")
  size       String   @default("")
  unit       String   @default("bag")
  mrp        Float    @default(0)
  basePrice  Float    @default(0)
  tiers      Json     // [[minQty, maxQty, price], ...]
  moq        Int      @default(1)
  step       Int      @default(1)
  cert       String   @default("ISI")
  inStock    Boolean  @default(true)
  stockQty   Int      @default(0)
  imageUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orderItems OrderItem[]
}

model Order {
  id            String      @id @default(cuid())
  retailerId    String
  totalAmount   Float
  status        OrderStatus @default(PLACED)
  paymentMethod String      @default("COD")
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  retailer Retailer    @relation(fields: [retailerId], references: [id])
  items    OrderItem[]
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  qty       Int
  unitPrice Float
  lineTotal Float

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

enum OrderStatus {
  PLACED
  PACKING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}
